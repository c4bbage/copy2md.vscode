{
  "name": "copy2md",
  "displayName": "copy2md",
  "description": "Copy code, files, and folders as Markdown",
  "version": "0.0.7",
  "publisher": "c4bbage",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "copy",
    "code",
    "files",
    "folders"
  ],
  "activationEvents": [
    "onCommand:extension.copyAsMarkdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.copyAllOpenedTabsAsMarkdown",
        "title": "Copy Tabs → Markdown"
      },
      {
        "command": "extension.copyCodeAsMarkdown",
        "title": "Copy Selection → Markdown"
      },
      {
        "command": "extension.copyFileAsMarkdown",
        "title": "Copy File → Markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "extension.copyCodeAsMarkdown",
          "group": "clipboard"
        },
        {
          "command": "extension.copyFileAsMarkdown",
          "group": "clipboard"
        },
        {
          "command": "extension.copyAllOpenedTabsAsMarkdown",
          "group": "clipboard"
        }
      ],
      "explorer/context": [
        {
          "command": "extension.copyFileAsMarkdown",
          "group": "clipboard"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/c4bbage/copy2md.vscode.git"
  },
  "bugs": {
    "url": "https://github.com/c4bbage/copy2md.vscode/issues"
  },
  "homepage": "https://github.com/c4bbage/copy2md.vscode#readme",
  "license": "MIT",
  "icon": "images/copy2md.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  }
}